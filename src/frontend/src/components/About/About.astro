---
import Portrait from '../Portrait/Portrait.astro';
import StageMarker from '../StageMarker/StageMarker.astro';
import { getLinkedInProfile, type LinkedInProfile } from '../../lib/linkedin';
import './About.css';

let profile: LinkedInProfile | null = null;
let loadError = false;

try {
  profile = await getLinkedInProfile();
} catch {
  loadError = true;
}

const name = [profile?.first_name].map((part) => part?.trim()).filter(Boolean).join(' ') || 'Adrian';
const headline = profile?.headline?.trim() ?? '';
const summary = profile?.summary?.trim() ?? '';
const location = profile?.location?.trim() ?? '';
const industry = profile?.industry?.trim() ?? '';
const hasDetails = Boolean(location || industry);
---

<section class="about" data-about data-stage>
  <StageMarker name="about" />
  <div class="about-content">
    <div class="about-copy">
      <h2 id="about-title">Hi,<br />I'm <span data-profile-name>{name}</span><span class="about-accent">.</span></h2>
      {headline && <p class="about-lead" data-profile-headline>{headline}</p>}
      {summary && <p class="about-description" data-profile-summary>{summary}</p>}
      {hasDetails && (
        <dl class="about-details" data-profile-details>
          {location && (
            <div data-profile-location-detail>
              <dt>Location</dt>
              <dd data-profile-location>{location}</dd>
            </div>
          )}
          {industry && (
            <div data-profile-industry-detail>
              <dt>Industry</dt>
              <dd data-profile-industry>{industry}</dd>
            </div>
          )}
        </dl>
      )}
      {loadError && (
        <>
          <p class="about-status" data-profile-status role="status">
            My profile is temporarily unavailable. Please try again later.
          </p>
          <button class="about-retry" data-profile-retry type="button">Try again</button>
        </>
      )}
    </div>

    <Portrait />
  </div>
</section>

<script>
  const retry = document.querySelector<HTMLButtonElement>('[data-profile-retry]');
  retry?.addEventListener('click', () => {
    window.location.reload();
  });
</script>

---
import Portrait from '../Portrait/Portrait.astro';
import './About.css';
---

<section class="about" data-about data-stage>
  <div class="about-content">
    <div class="about-copy">
      <p class="about-eyebrow">A little about me</p>
      <h2>Hi,<br />I'm Adrian<span>.</span></h2>
      <p class="about-lead">Good to see you here.</p>
      <p class="about-description">
        This is my space on the web — a place to share a little about me,
        my work, and the things that interest me.
      </p>
    </div>

    <Portrait />
  </div>
</section>
